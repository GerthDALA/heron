DATABASE_URL=sqlite+aiosqlite:///./heron.db
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-4-5
STRIPE_SECRET_KEY=your_stripe_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
RESEND_API_KEY=your_resend_key_here
JWT_SECRET_KEY=change_this_to_a_random_32_char_string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=10080
ALLOWED_ORIGINS=["http://localhost:3000"]
MAX_PAGES_STARTER=500
MAX_PAGES_BRAND=3000
SCAN_TIMEOUT_SECONDS=600
HERON_FROM_EMAIL=noreply@heron.app
FRONTEND_URL=http://localhost:3000
REPORTS_DIR=./reports
EVIDENCE_UPLOAD_MAX_MB=10
EVIDENCE_STORAGE_PATH=./evidence
ADS_SCAN_MAX_CHARS=50000
ADS_SCAN_MIN_CHARS=10
CORPUS_AUTO_RELOAD=true
# SSRF guard — set to true ONLY for local development against a mock storefront
CRAWLER_ALLOW_PRIVATE_HOSTS=false
CERT_EXPIRY_CHECK_HOURS=24
